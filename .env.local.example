# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة تحكم Supabase
# Copy this file to .env.local and fill in the values from your Supabase dashboard
# (Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Clé secrète — jamais exposée au client, utilisée uniquement dans les Route Handlers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
